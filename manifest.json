{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.1",
  "default_locale": "en_US",

  "browser_specific_settings": {
    "gecko": {
      "id": "feedcleaner@k0shir0",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage", "clipboardWrite", "declarativeNetRequest"],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yt-beacons",
        "enabled": false,
        "path": "dnr/yt-beacons.json"
      }
    ]
  },

  "background": {
    "scripts": ["background/service-worker.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": [
        "content/shared.js",
        "content/url-privacy.js",
        "content/youtube-player.js",
        "content/youtube-feed.js",
        "content/still-watching.js"
      ],
      "css": ["content/feedcleaner.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "FeedCleaner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'"
  }
}
